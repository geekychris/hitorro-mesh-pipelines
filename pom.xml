    <dependencies>
        <!-- Core Sink<T> lives in hitorro-core; JsonNodeSinkBase +
             NdjsonFileSink + MemoryTableSink live in hitorro-streams;
             KafkaSink in streams-kafka; NatsSink in streams-nats.
             Pulling them in as first-party deps rather than owning our
             own copies. -->
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-streams</artifactId>
            <version>${hitorro.version}</version>
        </dependency>
        <!-- JsonFileEntityStore / NamedTextValueStore / DurableScheduler used
             by the schedule/ package. Pulls in hitorro-core transitively too.
             Exclude slf4j-reload4j so downstream Spring Boot apps aren't
             surprised by a competing SLF4J binding at boot. -->
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-util</artifactId>
            <version>${hitorro.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-reload4j</artifactId>
                </exclusion>
                <!-- hitorro-util never calls the log4j 1 API; reload4j only
                     reached Spring Boot hosts as a stray logging backend. -->
                <exclusion>
                    <groupId>ch.qos.reload4j</groupId>
                    <artifactId>reload4j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-streams-kafka</artifactId>
            <version>${hitorro.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-streams-nats</artifactId>
            <version>${hitorro.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- Jackson YAML for JobSpec parsing. Databind + core come via streams→core.
             java.time (ScheduleStore) is built into Jackson 3 databind. -->
        <dependency>
            <groupId>tools.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>

        <!-- Spring integration is optional; the autoconfig activates only when
             Spring Boot is on the classpath. Users embedding the runtime
             without Spring construct JobRunner directly. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <version>${spring-boot.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
            <version>${spring-boot.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <version>7.0.11</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.1.0</version>
            <optional>true</optional>
            <scope>provided</scope>
        </dependency>

        <!-- Streaming adapters — optional. Runtime detection so a
             consumer without NATS or Kafka on the classpath gets a
             clear "adapter not on classpath" error instead of a
             NoClassDefFoundError. -->
        <dependency>
            <groupId>io.nats</groupId>
            <artifactId>jnats</artifactId>
            <version>2.27.0</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>3.9.2</version>
            <optional>true</optional>
        </dependency>

        <!-- Groovy for the groovy-map step. Users author transform scripts
             inline in job YAML; runtime evaluates with GroovyShell. Optional
             — the module works fine without it as long as no job uses
             groovy-map. -->
        <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy</artifactId>
            <version>4.0.21</version>
            <optional>true</optional>
        </dependency>

        <!-- Test scope. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.0.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>
        <!-- ApplicationContextRunner for the auto-configuration test. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test</artifactId>
            <version>${spring-boot.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <version>7.0.11</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- Spring @PathVariable / @RequestParam need parameter
                         names at runtime; otherwise the container throws
                         "parameter name information not available". -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>

